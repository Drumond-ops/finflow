# Copie este arquivo para ".env" e troque os valores.
# O .env NÃO vai para o GitHub (está no .gitignore); este .env.example vai, como modelo.

# ---------- Banco (usado pelo docker-compose E pela API) ----------
POSTGRES_USER=admin_financas
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=financeiro_db
DB_HOST=localhost
DB_PORT=5432

# ---------- Login (JWT) ----------
# Gere uma chave com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cole_aqui_uma_chave_longa_e_aleatoria
MINUTOS_EXPIRACAO_TOKEN=1440

# ---------- CORS: endereços do frontend, separados por vírgula ----------
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
