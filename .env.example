# OPCIONAL. Sem este arquivo o projeto roda com os valores padrão de desenvolvimento.
# Para usar valores próprios: copie para ".env" (na raiz do projeto) e troque os valores.
# O .env NÃO vai para o GitHub (está no .gitignore); este .env.example vai, como modelo.

# ---------- Banco (usado pelo docker-compose e pelas duas APIs) ----------
POSTGRES_USER=admin_financas
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=financeiro_db
# Usados só quando você roda uma API fora do Docker (o banco do docker-compose fica em localhost:5433)
DB_HOST=localhost
DB_PORT=5433

# ---------- Login (JWT) — a MESMA chave vale para a API Python e para a API Java ----------
# Gere uma chave com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cole_aqui_uma_chave_longa_e_aleatoria
MINUTOS_EXPIRACAO_TOKEN=1440

# ---------- CORS: endereços de onde o frontend pode chamar as APIs, separados por vírgula ----------
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500
